{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "zhushu-notes-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"ENVIRONMENT": "production",
		"JWT_SECRET": "change-this-secret-in-production"
	},
	"r2_buckets": [
		{
			"binding": "KNOWLEDGE_BUCKET",
			"bucket_name": "zhushu-knowledge-base",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "zhushu-community",
			"database_id": "32cc4bdb-266e-409b-9da4-88751ba715b6",
			"remote": true
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"vectorize": [
		{
			"binding": "VECTOR_INDEX",
			"index_name": "zhushu-annotations",
			"remote": true
		}
	]
}
